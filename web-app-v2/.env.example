# ─────────────────────────────────────────────────
#  HEB Price Tracker — Environment Variables
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to git.
# ─────────────────────────────────────────────────

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=heb_products
DB_USER=memorodriguez
DB_PASSWORD=

# Flask
# Generate a strong key: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-this-with-a-long-random-string

# Set to true only during local development
FLASK_DEBUG=false

# Port (default 8080 to avoid macOS AirPlay conflict on 5000)
PORT=8080
